{
  "name": "gio-music",
  "version": "1.3.20",
  "description": "Client musicale per Navidrome e Subsonic con libreria sincronizzata, download offline e integrazione Android Auto.",
  "license": "MIT",
  "author": "GioMocchi03",
  "repository": {
    "type": "git",
    "url": "https://github.com/GioMocchi03/music-bank.git"
  },
  "bugs": {
    "url": "https://github.com/GioMocchi03/music-bank/issues"
  },
  "homepage": "https://github.com/GioMocchi03/music-bank#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tauri-apps/api": "^2.12.4",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "js-md5": "^0.9.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "scripts": {
    "postinstall": "node tools/patch-android-dependencies.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "check:version": "node tools/check-version.mjs",
    "check:docs": "node tools/check-doc-links.mjs",
    "export:check": "expo export --platform all --output-dir .codex-export-check",
    "build:android": "node tools/build-android.mjs",
    "check": "npm run check:version && npm run check:docs && npm run typecheck && npm test"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
