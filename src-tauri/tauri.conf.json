{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Bank",
  "version": "1.3.9",
  "identifier": "io.servergio.musicbank.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
