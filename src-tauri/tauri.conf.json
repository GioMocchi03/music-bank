{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Bank",
  "version": "../package.json",
  "identifier": "io.servergio.musicbank.desktop",
  "build": {
    "beforeDevCommand": "npm run web -- --host localhost --port 8081",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run export:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Music Bank",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
